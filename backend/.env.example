# === Server ===
PORT=8080
NODE_ENV=development

# === Database ===
# Overridden by docker-compose environment block when running in Docker
DATABASE_URL=postgresql://windom:windom@localhost:5432/windom

# === Auth secrets - generate with: openssl rand -base64 32 ===
JWT_ACCESS_SECRET=change-me-access-secret-32-chars-minimum-x
REFRESH_TOKEN_SECRET=change-me-refresh-secret-32-chars-minimum

# === AES-GCM key for OAuth token encryption - 32 random bytes, base64 encoded ===
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEY_BASE64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# === Google OAuth (for both sign-in and Calendar) ===
GOOGLE_CLIENT_ID=<your-google-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-google-client-secret>
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/oauth/google/callback

# Whether to offer the Gmail widget. It needs gmail.readonly, which Google
# classes as a RESTRICTED scope: publishing an app that requests it requires a
# third-party CASA assessment at $500-4,500 a year, recurring. Leave this off
# unless that assessment is done and paid for - turning it on is what makes the
# Chrome Web Store listing unpublishable. See issue #321.
GMAIL_ENABLED=false

# === Spotify OAuth ===
SPOTIFY_CLIENT_ID=<your-spotify-client-id>
SPOTIFY_CLIENT_SECRET=<your-spotify-client-secret>
SPOTIFY_REDIRECT_URI=http://localhost:8080/oauth/spotify/callback

# === CORS ===
CORS_ALLOWED_ORIGINS=chrome-extension://<your-chrome-extension-id>,http://localhost:3000,http://localhost:5173

# === Frontend ===
EXTENSION_REDIRECT_BASE=https://<your-chrome-extension-id>.chromiumapp.org

# === Email (SMTP) ===
# Any SMTP provider works. Omit SMTP_HOST/SMTP_PORT to keep the Gmail defaults.
#   Gmail / Workspace : smtp.gmail.com  465   user = the account with the App Password
#   Resend            : smtp.resend.com 465   user = the literal string "resend"
#   Brevo             : smtp-relay.brevo.com 587
# Port 465 uses implicit TLS; 587 upgrades via STARTTLS. The code follows the port.
#
# FROM_EMAIL is the "From" shown to users. On Gmail it must be SMTP_USER or a verified
# "Send as" alias of it; dedicated providers only require the domain to be verified.
# App Password (Gmail only): myaccount.google.com → Security → 2-Step Verification → App Passwords
# Optional in dev - if SMTP_USER/SMTP_PASS are unset, emails are printed to console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=<smtp-username>
SMTP_PASS=<smtp-password-or-api-key>
FROM_EMAIL=noreply@windom.app
APP_URL=http://localhost:8080
